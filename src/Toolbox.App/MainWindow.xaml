<Window x:Class="Toolbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Toolbox.App.Views" Title="Toolbox · 工具箱">
  <Grid x:Name="RootGrid" Background="#F5F7F6" RequestedTheme="Light">
    <Grid.Resources>
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#137F70" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#198F7F" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#116B5D" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#137F70" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#198F7F" />
      <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="#137F70" />
      <SolidColorBrush x:Key="GridViewItemSelectedBackground" Color="#E4F1E9" />
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#137F70" />
    </Grid.Resources>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="188"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Background="#182923" Padding="16,28,16,22" RequestedTheme="Dark">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,20">
          <Border Width="36" Height="36" CornerRadius="11" Background="#317C61">
            <Path Width="24" Height="24" Data="M8,7 V4 H16 V7 M4,7 H20 V20 H4 Z M4,12 H20 M10,11 V15 H14 V11" Stroke="#D4FAE5" StrokeThickness="1.5" StrokeLineJoin="Round" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="工具箱" FontSize="22" FontWeight="SemiBold" Foreground="#F1F7F4" />
            <TextBlock Text="TOOLBOX  /  0.1.5" FontSize="8" CharacterSpacing="20" Foreground="#93ACA0" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ToolNavigation" Spacing="4" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="14" Margin="10,20,2,0">
          <StackPanel x:Name="ShortcutHints" Spacing="8">
            <TextBlock Text="快速捕获" Foreground="#849E91" FontSize="11" />
            <TextBlock Text="截图   Ctrl + Shift + S" Foreground="#AFC2B7" FontSize="10" />
            <TextBlock Text="长图   Ctrl + Shift + L" Foreground="#AFC2B7" FontSize="10" />
            <TextBlock Text="录屏   Ctrl + Shift + R" Foreground="#AFC2B7" FontSize="10" />
          </StackPanel>
          <Border Height="1" Background="#30483C" Margin="0,6,0,2" />
          <TextBlock x:Name="ShortcutText" Text="所有内容，保存在本机。" TextWrapping="Wrap" Foreground="#849E91" FontSize="10" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <InfoBar x:Name="StatusBar" Margin="28,12,28,0" IsOpen="False" IsClosable="True" Severity="Informational" />
      <views:ToolHomeView x:Name="HomePage" Grid.Row="1" />
      <ScrollViewer x:Name="CapturePage" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
        <StackPanel Padding="28,28,28,24" Spacing="22" MaxWidth="1160" HorizontalAlignment="Stretch">
          <StackPanel Spacing="6">
            <TextBlock x:Name="CaptureTitle" Text="屏幕截图" FontSize="28" FontWeight="SemiBold" Foreground="#1E3027" />
            <TextBlock x:Name="CaptureDescription" FontSize="13" Foreground="#78867F" TextWrapping="Wrap" />
          </StackPanel>
          <Border x:Name="ScreenshotTool" Background="White" BorderBrush="#E2E8E3" BorderThickness="1" CornerRadius="16" Padding="24">
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="12">
                <TextBlock Text="屏幕截图" FontSize="22" FontWeight="SemiBold" Foreground="#1E3027" />
                <TextBlock Text="矩形 · 窗口 · 全屏 · 任意形状" FontSize="13" Foreground="#78867F" />
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                  <Button x:Name="ScreenshotButton" Content="新建截图" Click="Screenshot_Click" Style="{StaticResource AccentButtonStyle}" Width="140" Height="40" CornerRadius="8" />
                  <TextBlock Text="Ctrl + Shift + S" FontSize="11" Foreground="#95A19A" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Background="#EDF5EF" CornerRadius="12" Padding="20">
                <Grid>
                  <Border BorderBrush="#85B49D" BorderThickness="1.5" CornerRadius="5" Margin="2,4,2,4" />
                  <FontIcon Glyph="&#xE91B;" Foreground="#3B8D6B" FontSize="32" />
                </Grid>
              </Border>
            </Grid>
          </Border>
            <Border x:Name="ScrollTool" Background="White" BorderBrush="#E2E8E3" BorderThickness="1" CornerRadius="14" Padding="24" Visibility="Collapsed">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Glyph="&#xE8A5;" Foreground="#347D60" FontSize="20" />
                  <TextBlock Text="自动长截图" FontSize="18" FontWeight="SemiBold" Foreground="#1E3027" />
                  <Border CornerRadius="4" Background="#F5F0DF" Padding="6,2"><TextBlock Text="实验" FontSize="10" Foreground="#927538" /></Border>
                </StackPanel>
                <TextBlock Text="框选后自动滚动拼接，停止即可保存。" TextWrapping="Wrap" FontSize="12" Foreground="#78867F" MinHeight="34" />
                <Button x:Name="ScrollButton" Content="开始长截图" Click="Scroll_Click" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Text="Ctrl + Shift + L 开始 · Ctrl + Shift + F 结束并保存" FontSize="12" Foreground="#78867F" />
              </StackPanel>
            </Border>
            <Border x:Name="RecordingTool" Background="White" BorderBrush="#E2E8E3" BorderThickness="1" CornerRadius="14" Padding="24" Visibility="Collapsed">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon Glyph="&#xE714;" Foreground="#B67157" FontSize="20" />
                  <TextBlock Text="录制屏幕" FontSize="18" FontWeight="SemiBold" Foreground="#1E3027" />
                </StackPanel>
                <TextBlock Text="MP4 · 30 fps · 支持暂停与继续" TextWrapping="Wrap" FontSize="12" Foreground="#78867F" MinHeight="34" />
                <Button x:Name="RecordButton" Content="开始录屏" Click="Record_Click" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Text="Ctrl + Shift + R 开始或结束录屏" FontSize="12" Foreground="#78867F" />
              </StackPanel>
            </Border>
          <StackPanel x:Name="CaptureSettings" Spacing="14">
            <Grid>
              <TextBlock Text="捕获设置" FontSize="15" FontWeight="SemiBold" Foreground="#465D50" />
            </Grid>
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="DisplayPicker" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="捕获显示器" />
              <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Click="Refresh_Click" />
            </Grid>
            <StackPanel x:Name="AudioSettings" Orientation="Horizontal" Spacing="24">
              <CheckBox x:Name="SystemAudioCheck" Content="系统声音" IsChecked="True" FontSize="13" />
              <CheckBox x:Name="MicrophoneCheck" Content="麦克风" IsChecked="False" FontSize="13" />
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="SessionControls" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
            <Button x:Name="PauseButton" Content="暂停录制" Click="Pause_Click" />
            <Button x:Name="StopButton" Content="结束并保存" Click="Stop_Click" Style="{StaticResource AccentButtonStyle}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <views:LibraryView x:Name="LibraryPage" Grid.Row="1" Visibility="Collapsed" />
      <views:FileToolsView x:Name="FileToolsPage" Grid.Row="1" Visibility="Collapsed" />
      <views:ImageViewerView x:Name="ImageViewerPage" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
  </Grid>
</Window>
