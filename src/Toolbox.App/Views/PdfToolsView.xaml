<UserControl x:Class="Toolbox.App.Views.PdfToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="20,20,20,12" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="PDF 工具" FontSize="26" FontWeight="SemiBold" Foreground="#1E3027" />
      <TextBlock x:Name="DocumentSummary" Text="预览、整理和编辑页面。原件保留，导出新文件。" FontSize="12" Foreground="#78867F" TextWrapping="Wrap" />
    </StackPanel>
    <CommandBar x:Name="Commands" Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
      <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="打开" Click="Open_Click" />
      <AppBarButton x:Name="MergeButton" Icon="Add" Label="合并" Click="Merge_Click" />
      <AppBarButton x:Name="ExportButton" Icon="Save" Label="导出" Click="Export_Click" IsEnabled="False" />
      <AppBarButton x:Name="SplitButton" Icon="Cut" Label="拆分" Click="Split_Click" IsEnabled="False" />
      <AppBarButton x:Name="UndoButton" Icon="Undo" Label="撤销" Click="Undo_Click" IsEnabled="False" />
      <AppBarButton x:Name="RedoButton" Icon="Redo" Label="重做" Click="Redo_Click" IsEnabled="False" />
    </CommandBar>
    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="#E2E8E3" BorderThickness="1" CornerRadius="12" Padding="10">
        <Grid RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="PageRange" PlaceholderText="1-3,5" FontSize="12" ToolTipService.ToolTip="页码留空选择全部；支持 3-1 倒序" />
            <Button Grid.Column="1" Content="选" Click="SelectRange_Click" Padding="8,4" ToolTipService.ToolTip="选择页码范围" />
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="3">
            <Button x:Name="UpButton" Content="↑" Padding="8,4" Click="Up_Click" ToolTipService.ToolTip="所选页面上移" />
            <Button x:Name="DownButton" Content="↓" Padding="8,4" Click="Down_Click" ToolTipService.ToolTip="所选页面下移" />
            <Button x:Name="RotateButton" Padding="8,4" Click="Rotate_Click" ToolTipService.ToolTip="所选页面顺时针旋转"><FontIcon Glyph="&#xE7AD;" FontSize="14"/></Button>
            <Button x:Name="RemoveButton" Padding="8,4" Click="Remove_Click" ToolTipService.ToolTip="删除所选页面，可撤销"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
          </StackPanel>
          <ListView x:Name="PageList" Grid.Row="2" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" SelectionChanged="Page_SelectionChanged">
            <ListView.ItemTemplate><DataTemplate>
              <StackPanel Spacing="3" Padding="0,6">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#78867F" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#63796B" />
              </StackPanel>
            </DataTemplate></ListView.ItemTemplate>
          </ListView>
          <ComboBox x:Name="EditList" Grid.Row="3" Header="本页编辑" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="Edit_SelectionChanged" />
          <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4">
            <Button x:Name="UpdateEditButton" Content="改文字" Padding="7,4" FontSize="12" Click="UpdateEdit_Click" IsEnabled="False" />
            <Button x:Name="RemoveEditButton" Content="删标记" Padding="7,4" FontSize="12" Click="RemoveEdit_Click" IsEnabled="False" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="EditMode" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Mode_Changed">
            <ComboBoxItem Content="浏览"/><ComboBoxItem Content="添加文字"/><ComboBoxItem Content="批注文本框"/><ComboBoxItem Content="标记区域"/><ComboBoxItem Content="安全遮盖"/>
          </ComboBox>
          <Button Grid.Column="1" Content="适应" Click="Fit_Click" Padding="9,4" />
          <DropDownButton Grid.Column="2" Content="缩放" Padding="9,4">
            <DropDownButton.Flyout><MenuFlyout>
              <MenuFlyoutItem Text="放大" Click="ZoomIn_Click"/>
              <MenuFlyoutItem Text="缩小" Click="ZoomOut_Click"/>
              <MenuFlyoutItem Text="适合宽度" Click="FitWidth_Click"/>
            </MenuFlyout></DropDownButton.Flyout>
          </DropDownButton>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="6">
          <Grid x:Name="TextEditor" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
            <TextBox x:Name="OverlayText" PlaceholderText="输入文字，然后在页面上拖出文本区域" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="75" MinHeight="40" MaxLength="4000" />
            <NumberBox x:Name="FontSizePicker" Grid.Column="1" Header="字号 pt" Minimum="6" Maximum="144" Value="14" SmallChange="1" SpinButtonPlacementMode="Compact" />
          </Grid>
          <TextBlock x:Name="EditHint" Text="选择左侧页面进行预览；按住 Ctrl 可选择多页。" FontSize="11" Foreground="#63796B" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="2" Background="#E8EEEA" CornerRadius="12" BorderBrush="#DAE3DC" BorderThickness="1">
          <Grid>
            <TextBlock x:Name="EmptyHint" Text="打开一个 PDF 开始" Foreground="#78867F" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ScrollViewer x:Name="PreviewScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Preview_SizeChanged" Padding="12">
              <Grid x:Name="PageSurface" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Image x:Name="PageImage" Stretch="Fill" />
                <Canvas x:Name="EditCanvas" Background="Transparent" PointerPressed="Canvas_Pressed" PointerMoved="Canvas_Moved" PointerReleased="Canvas_Released" PointerCanceled="Canvas_Canceled" PointerCaptureLost="Canvas_Canceled">
                  <Rectangle x:Name="DragRectangle" Fill="#404B9D7B" Stroke="#137F70" StrokeThickness="1.5" Visibility="Collapsed" />
                </Canvas>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <InfoBar x:Name="Status" Grid.Row="3" IsOpen="False" IsClosable="True" />
    <Grid Grid.Row="4" ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ProgressText" Text="所有处理都在本机完成。" FontSize="11" Foreground="#78867F" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="Cancel_Click" Visibility="Collapsed" />
    </Grid>
  </Grid>
</UserControl>
