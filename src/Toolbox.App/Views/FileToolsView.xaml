<UserControl x:Class="Toolbox.App.Views.FileToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="28,28,28,24" Spacing="20" MaxWidth="1160" HorizontalAlignment="Stretch">
      <StackPanel Spacing="6">
        <TextBlock Text="文件处理" FontSize="28" FontWeight="SemiBold" Foreground="#1E3027" />
        <TextBlock Text="移动或删除文件，找出谁在占用。" FontSize="13" Foreground="#78867F" />
      </StackPanel>
      <Border Background="White" BorderBrush="#E2E8E3" BorderThickness="1" CornerRadius="16" Padding="20">
        <StackPanel Spacing="14">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SourcePath" Header="文件或文件夹" PlaceholderText="粘贴完整路径，或选择一个项目" TextChanged="Path_Changed" />
            <DropDownButton x:Name="PickSourceButton" Grid.Column="1" Content="选择" VerticalAlignment="Bottom">
              <DropDownButton.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="选择文件…" Click="PickFile_Click" />
                  <MenuFlyoutItem Text="选择文件夹…" Click="PickFolder_Click" />
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </Grid>
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="DestinationPath" Header="移动到（目标文件夹）" PlaceholderText="仅移动时需要，保留原名称" TextChanged="Path_Changed" />
            <Button x:Name="PickDestinationButton" Grid.Column="1" Content="浏览…" Click="PickDestination_Click" VerticalAlignment="Bottom" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="MoveButton" Content="移动" Click="Move_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="100" />
            <Button x:Name="DeleteButton" Content="移入回收站" Click="Delete_Click" />
          </StackPanel>
          <TextBlock Text="不会自动覆盖或合并同名内容。删除默认使用 Windows 回收站。" TextWrapping="Wrap" FontSize="12" Foreground="#78867F" />
        </StackPanel>
      </Border>
      <InfoBar x:Name="OperationStatus" IsOpen="False" IsClosable="True" />
      <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
        <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
        <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Text="正在处理…" />
        <Button x:Name="CancelButton" Content="取消查询" Click="Cancel_Click" Visibility="Collapsed" />
      </StackPanel>
      <Border Background="White" BorderBrush="#E2E8E3" BorderThickness="1" CornerRadius="16" Padding="20">
        <StackPanel Spacing="14">
          <TextBlock Text="占用进程" FontSize="20" FontWeight="SemiBold" Foreground="#1E3027" />
          <TextBlock x:Name="LockSummary" Text="移动或删除失败时，会自动检查并在这里显示占用进程。" TextWrapping="Wrap" Foreground="#78867F" FontSize="13" />
          <ListView x:Name="ProcessList" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" MaxHeight="320" SelectionChanged="Process_SelectionChanged">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="6" Padding="4,10">
                  <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#63796B" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock x:Name="ScanWarnings" TextWrapping="Wrap" FontSize="12" Foreground="#927538" Visibility="Collapsed" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="TerminateButton" Content="结束选中进程…" Click="Terminate_Click" IsEnabled="False" />
            <Button x:Name="RetryButton" Content="重试操作" Click="Retry_Click" IsEnabled="False" />
          </StackPanel>
          <TextBlock Text="请先尝试关闭相关文件。结束进程可能丢失该程序未保存的工作；只处理你勾选并确认的进程。" TextWrapping="Wrap" FontSize="12" Foreground="#78867F" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
