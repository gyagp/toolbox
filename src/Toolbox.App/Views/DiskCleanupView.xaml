<UserControl x:Class="Toolbox.App.Views.DiskCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Toolbox.App.Views">
  <Grid>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="28,24,28,24" Spacing="14" MaxWidth="1160" HorizontalAlignment="Stretch">
      <StackPanel Spacing="6">
        <TextBlock Text="磁盘清理" FontSize="28" FontWeight="SemiBold" Foreground="#1E3027" />
        <TextBlock Text="只读查看磁盘占用，或预览并整理已核对的 Codex 旧程序包。" FontSize="13" Foreground="#78867F" TextWrapping="Wrap" />
      </StackPanel>
      <Border Background="#EDF5EF" BorderBrush="#D5E7DB" BorderThickness="1" CornerRadius="14" Padding="14">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE73E;" Foreground="#347D60" FontSize="22" VerticalAlignment="Top" Margin="0,3,0,0" />
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="常规磁盘扫描只读，交给 Windows 审查清理；Codex 旧版本单独预览、确认后才删除。临时文件可能仍有用途。不会清空回收站或结束进程。" TextWrapping="Wrap" FontSize="12" Foreground="#526E5E" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Background="White" BorderBrush="#E2E8E3" BorderThickness="1" CornerRadius="16" Padding="20">
        <StackPanel Spacing="14">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="DrivePicker" Header="本地磁盘" MinWidth="160" HorizontalAlignment="Stretch" SelectionChanged="Drive_Changed" />
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Click="Refresh_Click" VerticalAlignment="Bottom" />
          </Grid>
          <ProgressBar x:Name="DiskUsage" Minimum="0" Maximum="100" Value="0" Height="6" Foreground="#347D60" />
          <TextBlock x:Name="CapacityText" Text="选择磁盘以查看容量。" FontSize="12" Foreground="#63796B" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="ScanButton" Content="只读扫描" Click="Scan_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
            <Button x:Name="CancelButton" Content="取消扫描" Click="Cancel_Click" Visibility="Collapsed" />
            <ProgressRing x:Name="ScanRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
          </StackPanel>
          <TextBlock x:Name="ScanStatus" Text="只读检查已知缓存与回收站，不扫描个人文件夹。" FontSize="12" Foreground="#78867F" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <views:CodexCleanupView x:Name="CodexPage" />
      <InfoBar x:Name="OperationStatus" IsOpen="False" IsClosable="True" />
      <Border Background="White" BorderBrush="#E2E8E3" BorderThickness="1" CornerRadius="16" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="在 Windows 中审查" FontSize="18" FontWeight="SemiBold" Foreground="#1E3027" />
          <TextBlock Text="Windows 会列出清理类别，等待你选择并确认。请保留不确定的项目；下载、回收站、恢复或回退安装可能包含你仍需要的内容。" TextWrapping="Wrap" FontSize="12" Foreground="#63796B" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="CleanupButton" Content="Windows 磁盘清理…" Click="Cleanup_Click" IsEnabled="False" />
            <Button x:Name="StorageButton" Content="存储设置…" Click="Storage_Click" />
          </StackPanel>
          <TextBlock Text="不会启用自动清理或替你勾选类别。完成后返回这里重新扫描。" TextWrapping="Wrap" FontSize="12" Foreground="#78867F" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="6">
        <TextBlock Text="占用参考" FontSize="18" FontWeight="SemiBold" Foreground="#1E3027" />
        <TextBlock x:Name="ResultsCaption" Text="尚未扫描。大小估算不代表可释放空间；压缩、硬链接及扫描期间的变化会影响数值。" TextWrapping="Wrap" FontSize="12" Foreground="#78867F" />
      </StackPanel>
      <ItemsControl x:Name="ResultsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="White" BorderBrush="#E2E8E3" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,10">
              <StackPanel Spacing="7">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#1E3027" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SizeText}" FontSize="20" FontWeight="SemiBold" Foreground="#347D60" />
                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#78867F" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Guidance}" FontSize="12" Foreground="#63796B" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#78867F" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
    <Border x:Name="CodexCancelTray" Grid.Row="1" Padding="28,12" BorderBrush="#E2E8E3" BorderThickness="0,1,0,0" Background="#F5F7F6" Visibility="Collapsed">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Codex 版本整理中 · 取消不回滚已完成的删除" FontSize="12" Foreground="#63796B" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="取消操作" Click="CodexCancel_Click" CornerRadius="8" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
